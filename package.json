{
  "name": "swarm-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "package": "./scripts/package-installers.sh",
    "build:dmg": "pnpm --filter @swarm/app build && pnpm --filter @swarm/app tauri build --bundles dmg && ./scripts/package-installers.sh",
    "tauri": "pnpm --filter @swarm/app tauri",
    "tauri:dev": "pnpm --filter @swarm/app tauri:dev",
    "tauri:build": "pnpm --filter @swarm/app tauri:build"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
