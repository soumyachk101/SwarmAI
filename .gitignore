# ==============================================================================
# Release Installers & Compiled Binaries
# (Compiled binaries in root releases/ local staging are ignored)
# ==============================================================================
releases/**/*.dmg
releases/**/*.exe
releases/**/*.msi
releases/**/*.deb
releases/**/*.app
releases/**/*.zip
releases/**/*.tar.gz
releases/**/*.rpm
/releases/*.dmg
/releases/*.exe
/releases/*.msi
/releases/*.deb

# Keep gitkeep placeholders
!releases/**/.gitkeep
!web/releases/**/.gitkeep

# Explicitly allow web release binaries for GitHub Pages static site hosting
!web/releases/**
!web/releases/**/*.dmg
!web/releases/**/*.exe
!web/releases/**/*.msi
!web/releases/**/*.deb

